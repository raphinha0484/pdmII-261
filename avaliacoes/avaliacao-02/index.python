class Pilha:
    def __init__(self):
        self.itens = []

    def esta_vazia(self):
        return len(self.itens) == 0

    
    def empilhar(self, item):
        self.itens.append(item)
        print(f"{item} foi empilhado.")

   
    def desempilhar(self):
        if self.esta_vazia():
            print("A pilha está vazia!")
        else:
            removido = self.itens.pop()
            print(f"{removido} foi removido.")

    
    def topo(self):
        if self.esta_vazia():
            print("A pilha está vazia!")
        else:
            print(f"Topo da pilha: {self.itens[-1]}")

    
    def mostrar(self):
        if self.esta_vazia():
            print("A pilha está vazia!")
        else:
            print("Elementos da pilha:", self.itens)



pilha = Pilha()

pilha.empilhar(10)
pilha.empilhar(20)
pilha.empilhar(30)

pilha.mostrar()
pilha.topo()

pilha.desempilhar()
pilha.mostrar()
